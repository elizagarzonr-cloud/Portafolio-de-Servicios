:root {
    --bg: #fafbfc;
    --surface: #fff;
    --ink: #12151a;
    --muted: #5f6672;
    --line: #e6e8ec;
    --hover: #f1f3f5;
    --risk: #e0540a;
    --shadow: 0 0 0 1px rgba(18, 21, 26, .08), 0 1px 2px rgba(18, 21, 26, .06);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 76px; -webkit-text-size-adjust: 100%; }
body { background: var(--bg); color: var(--ink); font: 16px/1.6 "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
a { color: inherit; text-decoration: none; }
button, input { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 8px; }
.wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
.muted { color: var(--muted); text-wrap: pretty; }
h1, h2, h3 { letter-spacing: -0.03em; font-weight: 600; text-wrap: balance; }
h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.12; }
h3 { font-size: 1.0625rem; letter-spacing: -0.01em; }

/* Navegación */
.nav { position: sticky; top: 0; z-index: 10; padding-top: env(safe-area-inset-top, 0px); background: color-mix(in srgb, var(--bg) 80%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
.nav .wrap { display: flex; align-items: center; gap: 24px; height: 60px; }
.brand { font-weight: 600; font-size: 15px; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-links { margin-left: auto; display: flex; align-items: center; gap: 22px; font-size: 14px; color: var(--muted); }
.nav-links a { transition: color 150ms ease; }
@media (hover: hover) { .nav-links a:hover { color: var(--ink); } .nav-links .btn:hover { color: var(--bg); } }

/* Botones */
.btn { display: inline-flex; align-items: center; justify-content: center; height: 42px; padding: 0 18px; border: 0; border-radius: 10px; font-size: 14px; font-weight: 500; line-height: 1; cursor: pointer; transition: transform 160ms var(--ease-out), background-color 160ms ease; }
.btn:active { transform: scale(0.97); }
.btn-sm { height: 34px; padding: 0 14px; }
.btn-primary { background: var(--ink); color: var(--bg); box-shadow: 0 1px 2px rgba(18, 21, 26, .2), inset 0 1px 0 rgba(255, 255, 255, .12); }
.btn-ghost { background: var(--surface); box-shadow: var(--shadow); }
@media (hover: hover) { .btn-primary:hover { background: #2a2f38; } .btn-ghost:hover { background: var(--hover); } }
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }

/* Hero */
.hero { padding-top: clamp(72px, 14vh, 136px); padding-bottom: clamp(56px, 9vw, 96px); }
.hero h1 { max-width: 16ch; font-size: clamp(2.5rem, 7.5vw, 4.5rem); line-height: 1.02; letter-spacing: -0.04em; }
.lead { max-width: 52ch; margin-top: 22px; font-size: 1.125rem; color: var(--muted); text-wrap: pretty; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: clamp(48px, 8vw, 80px); padding-top: 24px; border-top: 1px solid var(--line); }
.stats dt { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 600; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
.stats dd { margin: 0; font-size: 14px; color: var(--muted); }

/* Secciones */
.sec { padding-top: clamp(56px, 9vw, 104px); padding-bottom: clamp(24px, 4vw, 40px); }
.intro { max-width: 52ch; margin: 12px 0 32px; }

/* Calculadora */
.calc { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
.calc .muted { margin-top: 16px; max-width: 46ch; }
.tool { background: var(--surface); border-radius: 18px; padding: 24px; box-shadow: var(--shadow), 0 12px 32px -12px rgba(18, 21, 26, .12); }
.field { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 500; }
#employees { width: 100%; height: 44px; margin-bottom: 20px; padding: 0 14px; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; font-size: 16px; transition: border-color 150ms ease, box-shadow 150ms ease; }
#employees:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(18, 21, 26, .08); }
.seg { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; padding: 4px; background: var(--hover); border-radius: 12px; }
.seg label { position: relative; }
.seg input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
.seg span { display: grid; place-items: center; height: 38px; border-radius: 9px; font-size: 14px; font-weight: 500; color: var(--muted); transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease; }
.seg input:checked + span { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
.seg input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
.hint { margin-top: 8px; font-size: 13px; color: var(--muted); }
.result { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
.amount { margin: 4px 0 8px; font-size: clamp(2rem, 6vw, 2.75rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--risk); }
.fine-print { font-size: 13px; line-height: 1.5; color: var(--muted); }
.link { display: inline-block; margin-top: 14px; font-size: 14px; font-weight: 500; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line); transition: text-decoration-color 150ms ease; }
@media (hover: hover) { .link:hover { text-decoration-color: var(--ink); } }

/* Método */
.steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 40px; }
.steps li { padding-top: 20px; border-top: 1px solid var(--ink); }
.steps h3 { margin: 14px 0 8px; }
.n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: var(--bg); font-size: 13px; font-weight: 500; }

/* Servicios (acordeón) */
.svc { border-top: 1px solid var(--line); }
.svc:last-child { border-bottom: 1px solid var(--line); }
.svc-head { display: flex; align-items: center; gap: 14px; width: 100%; padding: 22px 0; background: none; border: 0; text-align: left; cursor: pointer; }
.svc-title { font-size: clamp(1.0625rem, 2.4vw, 1.25rem); font-weight: 500; letter-spacing: -0.02em; }
.tag { margin-left: auto; flex: none; padding: 3px 10px; border-radius: 99px; background: var(--hover); font-size: 12px; color: var(--muted); }
.chev { flex: none; width: 10px; height: 10px; border-right: 1.75px solid var(--muted); border-bottom: 1.75px solid var(--muted); transform: translateY(-2px) rotate(45deg); transition: transform 240ms var(--ease-out); }
.open .chev { transform: translateY(2px) rotate(-135deg); }
.panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 300ms var(--ease-out); }
.open .panel { grid-template-rows: 1fr; }
.panel > div { overflow: hidden; visibility: hidden; opacity: 0; transition: opacity 200ms ease, visibility 0s 300ms; }
.open .panel > div { visibility: visible; opacity: 1; transition: opacity 260ms ease 60ms, visibility 0s; }
.panel p { max-width: 56ch; }
.panel ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 32px; margin: 16px 0 26px; }
.panel li { position: relative; padding-left: 18px; font-size: 15px; color: var(--muted); }
.panel li::before { content: ""; position: absolute; left: 0; top: .62em; width: 8px; height: 1.5px; background: var(--ink); }
.panel li strong { color: var(--ink); font-weight: 500; }

/* Cita y pie */
.quote { max-width: 28em; font-size: clamp(1.375rem, 3.4vw, 2rem); line-height: 1.3; letter-spacing: -0.025em; font-weight: 500; text-wrap: balance; }
.foot { margin-top: clamp(64px, 10vw, 112px); padding: clamp(56px, 9vw, 96px) 0 32px; background: var(--ink); color: var(--bg); }
.foot h2 { max-width: 18ch; }
.foot .muted { margin-top: 14px; color: #a3aab5; }
.foot .btn-primary { background: var(--bg); color: var(--ink); box-shadow: none; }
.foot .btn-ghost { background: transparent; color: var(--bg); box-shadow: 0 0 0 1px rgba(255, 255, 255, .22); }
@media (hover: hover) { .foot .btn-primary:hover { background: #fff; } .foot .btn-ghost:hover { background: rgba(255, 255, 255, .08); } }
.copy { margin-top: clamp(48px, 8vw, 80px); padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, .12); font-size: 13px; color: #8a919c; }

/* Entrada: un solo momento al cargar */
.reveal { opacity: 0; animation: rise 640ms var(--ease-out) forwards; animation-delay: calc(var(--i, 0) * 80ms); }
@keyframes rise { from { opacity: 0; transform: translateY(8px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }

@media (max-width: 800px) {
    .calc, .steps { grid-template-columns: 1fr; }
    .panel ul { grid-template-columns: 1fr; }
    .hide-sm { display: none; }
}
@media (max-width: 560px) {
    .wrap { padding: 0 18px; }
    .tag { display: none; }
    .svc-head { justify-content: space-between; }
    .btn { flex: 1 1 auto; }
    .stats { gap: 12px; }
}
@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { animation: none; opacity: 1; }
    .panel, .panel > div, .chev, .btn { transition-duration: 1ms; transition-delay: 0s; }
}
